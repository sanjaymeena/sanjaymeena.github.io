# Copy to .env and fill in. Only PUBLIC_* variables reach the client bundle
# (Astro's default vite.envPrefix). Every variable here is optional: unset means
# the integration renders nothing at all, and both are production-builds-only.

# GA4 Measurement ID.
# The old `UA-78154345-1` Universal Analytics property is dead and is not carried
# over. TODO(sanjay): create a GA4 property and paste its G-XXXXXXXXXX here (and
# into the deploy workflow's environment).
PUBLIC_GA4_ID=

# Set to exactly "true" to render AdSense units (client pub-8491284845992193,
# slots in src/lib/site.ts).
# NOTE: the live Jekyll site has `ads.enabled: true`, so ads are absent from the
# Astro build until this is switched on.
PUBLIC_ADSENSE_ENABLED=
