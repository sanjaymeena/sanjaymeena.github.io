---
import { analyticsEnabled, ga4MeasurementId } from '../lib/integrations';

/**
 * GA4 via gtag.js.
 *
 * The old `_config.yml` had `tracking_id: "UA-78154345-1"` — a Universal
 * Analytics property, which stopped processing hits in 2023. It is deliberately
 * not carried over.
 *
 * The GA4 id comes from PUBLIC_GA4_ID, set per origin: a repository variable for
 * the GitHub Pages workflow, and inline in amplify.yml for CloudFront. Unset or
 * empty means this component renders nothing, so no page ships analytics bytes.
 *
 * Production builds only: `npm run dev` never loads GA.
 */
const enabled = analyticsEnabled();
const id = ga4MeasurementId();
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', id);
      </script>
    </>
  )
}
