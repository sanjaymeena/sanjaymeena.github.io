---
import {
  formatDateShort,
  formatDateShortWithYear,
  groupByYear,
  type ListedPost,
} from '../lib/posts';

export interface Props {
  posts: ListedPost[];
  /** Prefix each entry with its category, as the homepage did. */
  showCategory?: boolean;
  /** Render at most this many posts; the list is already newest-first. */
  limit?: number;
  /** Group into year sections (default). `false` renders one flat list. */
  grouped?: boolean;
}

const { posts, showCategory = false, limit, grouped = true } = Astro.props;
const visible = limit === undefined ? posts : posts.slice(0, limit);
const years = grouped ? groupByYear(visible) : [];
---

<div class="page_list">
  {
    grouped ? (
      years.map(({ year, posts: yearPosts }) => (
        <section class="page_list__year">
          {/* The `-ref` suffix on the year anchor matches the Jekyll templates, so
              existing /#2016-ref links keep working. */}
          <h2 id={`${year}-ref`}>{year}</h2>
          <ul class="posts">
            {yearPosts.map((post) => (
              <li class="posts__item">
                <time datetime={post.date.toISOString()}>{formatDateShort(post.date)}</time>
                <a href={post.url}>
                  {showCategory && post.category && <span class="posts__category">[{post.category}]</span>}{' '}
                  {post.title}
                </a>
                {post.excerpt && <p class="posts__excerpt">{post.excerpt}</p>}
              </li>
            ))}
          </ul>
        </section>
      ))
    ) : (
      /* Flat list: no year heading to supply context, so each date carries its
         own year rather than reading as an ambiguous "5 Jun". */
      <ul class="posts">
        {visible.map((post) => (
          <li class="posts__item">
            <time datetime={post.date.toISOString()}>{formatDateShortWithYear(post.date)}</time>
            <a href={post.url}>
              {showCategory && post.category && <span class="posts__category">[{post.category}]</span>}{' '}
              {post.title}
            </a>
            {post.excerpt && <p class="posts__excerpt">{post.excerpt}</p>}
          </li>
        ))}
      </ul>
    )
  }
</div>
