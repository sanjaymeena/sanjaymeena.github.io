---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { getAiMlPosts, getPostsByCategory } from '../lib/posts';
import { SITE } from '../lib/site';

const HOME_KEYWORDS = [
  'machine learning',
  'deep learning',
  'artificial intelligence',
  'value investing',
  'pharma',
  'stocks',
  'financial analysis',
  'nlp',
  'natural language processing',
  'Java',
  'behavioral finance',
  'data science',
  'information extraction',
  'information retrieval',
];

const aiPosts = await getAiMlPosts();
const investingPosts = await getPostsByCategory('investing');
const bookPosts = await getPostsByCategory('books');

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  description: 'Blog on A.I, Value Investing, Books, Technology',
  url: SITE.url,
};
---

<BaseLayout
  description="Blog on A.I, Value Investing, Books, Technology"
  keywords={HOME_KEYWORDS}
  image="/images/machine-learning.jpg"
  jsonLd={[websiteLd]}
>
  <main class="page">
    <h1 class="page__title">{SITE.title}</h1>

    <div class="page__intro">
      <h2>Hello there!</h2>
      <p>I maintain this Blog to record my learnings from different fields of Investing and Technology.</p>
      <p>
        You can also have a look at some of the tech projects i have worked on the over the years:
        <a href="/projects/">Projects</a>
      </p>
    </div>

    <section class="lane" aria-labelledby="lane-ai">
      <h2 id="lane-ai">AI/ML Engineering</h2>
      <PostList posts={aiPosts} limit={5} grouped={false} />
      <p class="lane__more"><a href="/ai/">More in AI/ML &rarr;</a></p>
    </section>

    <section class="lane" aria-labelledby="lane-investing">
      <h2 id="lane-investing">Investing</h2>
      <PostList posts={investingPosts} limit={5} grouped={false} />
      <p class="lane__more"><a href="/investment_notes/">More &rarr;</a></p>
    </section>

    <section class="lane" aria-labelledby="lane-books">
      <h2 id="lane-books">Books</h2>
      <PostList posts={bookPosts} limit={5} grouped={false} />
      <p class="lane__more"><a href="/book_notes/">More &rarr;</a></p>
    </section>

    <p class="page__lede"><a href="/posts/">Browse all posts &rarr;</a></p>
  </main>
</BaseLayout>
